# Example environment variables for local development
# Copy to .env.local or .env and fill values

# Vercel Blob read/write token (create in Vercel dashboard -> Storage -> Tokens)
BLOB_READ_WRITE_TOKEN=

# Optional: set to 'public' or 'private' for blob access defaults
BLOB_ACCESS=private

# Stripe (example placeholders)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Other app settings
NEXT_PUBLIC_USE_STUBS=false
# MongoDB - Use local Docker container when running stubs.
MONGODB_URI=mongodb://localhost:27017/preset-store

# Dev-only seed endpoint secret. If set, include this value in the `x-dev-seed-secret` header when POSTing to /api/dev/seed.
# Only used in development; do NOT set this in production.
DEV_SEED_SECRET=your-dev-seed-secret

# Stripe - For localhost with stripe-mock
STRIPE_SECRET_KEY=sk_test_stub
STRIPE_HOST=localhost
STRIPE_PORT=12111
STRIPE_PROTOCOL=http
STRIPE_WEBHOOK_SECRET=whsec_stub

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Download token secret (any random string for localhost)
DOWNLOAD_TOKEN_SECRET=dev-secret-change-in-production

# Blob storage - Leave empty to use stub service, or provide real Vercel token
BLOB_READ_WRITE_TOKEN=

# Clerk - Leave empty to use stub service, or provide real Clerk keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stub service configuration (for localhost development)
STUBS_BASE_URL=http://localhost:4010
NEXT_PUBLIC_USE_STUBS=1
