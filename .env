# MongoDB - code reads MONGODB_URL (not MONGODB_URI)
MONGODB_URL=mongodb://localhost:27017/preset-store

# Download token secret
DOWNLOAD_TOKEN_SECRET=dev-secret-change-in-production

# Stripe - stub config for local dev
STRIPE_SECRET_KEY=sk_test_stub
STRIPE_HOST=localhost
STRIPE_PORT=12111
STRIPE_PROTOCOL=http
STRIPE_WEBHOOK_SECRET=whsec_stub

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Use stubs for development (auth is already stubbed in code)
NEXT_PUBLIC_USE_STUBS=1
STUBS_BASE_URL=http://localhost:4010

# Blob storage - leave empty for dev
BLOB_READ_WRITE_TOKEN=

# Clerk - leave empty, auth is stubbed
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Dev seed secret
DEV_SEED_SECRET=your-dev-seed-secret
